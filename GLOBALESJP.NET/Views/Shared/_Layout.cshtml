<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "TI | GLOBALESJP.NET")</title>
    
    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/logo-jp.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/logo-jp.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/logo-jp.png" asp-append-version="true" />
    
    <meta name="description" content="GLOBALES JP - Soluciones de Software a Medida, Dominios y Cloudflare, Google Workspace, Soluciones Gemini AI y Diagnósticos Técnicos Remotos Empresariales." />
    <meta name="keywords" content="Globales JP, Servicios TI, Desarrollo Web, Aplicaciones a Medida, Cloudflare, Dominios, DNS, Google Workspace, Gemini AI, Diagnósticos Remotos, Software Empresarial, ERP, Cursos" />
    <meta name="author" content="Inversiones Globales JP 1968, C.A." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 & Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Custom Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Script de inicialización de tema para evitar parpadeos -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('jp-theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <!-- Ambient Background Lighting & Tech Grid Overlay -->
    <div class="bg-ambient-layer">
        <div class="ambient-blob ambient-blob-1"></div>
        <div class="ambient-blob ambient-blob-2"></div>
        <div class="ambient-blob ambient-blob-3"></div>
        <div class="tech-grid-overlay"></div>
    </div>

    <!-- Navigation Header -->
    <header>
        <nav class="navbar navbar-expand-lg jp-navbar">
            <div class="container">
                <a class="navbar-brand-wrapper" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-jp.png" alt="GLOBALES JP Logo" class="brand-logo-img" />
                    <div>
                        <span class="brand-text-title">GLOBALES JP</span>
                        <span class="brand-text-sub">Servicios TI &amp; Software</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 shadow-none text-light" type="button" data-bs-toggle="collapse" data-bs-target="#jpNavbarNav" aria-controls="jpNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <div class="collapse navbar-collapse" id="jpNavbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link jp-nav-link" href="/#inicio">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link jp-nav-link" href="/#servicios">Servicios TI</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link jp-nav-link" href="/#ecosistema">Ecosistema</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link jp-nav-link" href="/#diagnosticos">Diagnósticos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link jp-nav-link" asp-controller="Home" asp-action="Nosotros">Nosotros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link jp-nav-link" href="/#contacto">Contacto</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <!-- Theme Toggle Button (Dark / Light) -->
                        <button id="themeToggleBtn" type="button" class="btn-jp-theme-toggle" title="Cambiar a Modo Claro" aria-label="Cambiar tema">
                            <i class="bi bi-sun-fill" id="themeIcon"></i>
                        </button>
                        <!-- ERP Online Button (Acceso Directo al Sistema) -->
                        <a href="https://erp.globalesjp.net/" target="_blank" rel="noopener noreferrer" class="btn btn-jp-erp btn-sm-custom" title="Ingresar a GLOBALES JP | ERP">
                            <i class="bi bi-grid-3x3-gap-fill text-warning"></i>
                            <span>ERP Online</span>
                        </a>
                        <!-- Cursos Online Button -->
                        <a href="https://cursos.globalesjp.net/" target="_blank" rel="noopener noreferrer" class="btn btn-jp-outline btn-sm-custom" title="Campus Virtual Cursos Globales JP">
                            <i class="bi bi-mortarboard-fill text-info"></i>
                            <span>Cursos Online</span>
                        </a>
                        <!-- WhatsApp Direct -->
                        <a href="https://wa.me/584142241795?text=Hola%20Globales%20JP,%20deseo%20consultar%20sobre%20sus%20servicios%20de%20Software%20y%20TI" target="_blank" rel="noopener noreferrer" class="btn btn-jp-whatsapp btn-sm-custom">
                            <i class="bi bi-whatsapp"></i>
                            <span>WhatsApp</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Floating WhatsApp Action Button -->
    <a href="https://wa.me/584142241795?text=Hola%20Globales%20JP,%20deseo%20atenci%C3%B3n%20inmediata%20para%20un%20proyecto%20o%20diagn%C3%B3stico%20TI" 
       target="_blank" 
       rel="noopener noreferrer" 
       class="floating-whatsapp" 
       title="Chatear con soporte TI en WhatsApp"
       aria-label="Contacto directo por WhatsApp">
        <span class="pulse-ring"></span>
        <i class="bi bi-whatsapp"></i>
    </a>

    <!-- Corporate Footer -->
    <footer class="jp-footer">
        <div class="container">
            <div class="row g-4 mb-5">
                <!-- Col 1: Brand & Identity -->
                <div class="col-lg-5 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/logo-jp.png" alt="GLOBALES JP" class="brand-logo-img" style="width: 38px; height: 38px;" />
                        <span class="brand-text-title fs-5">GLOBALES JP</span>
                    </div>
                    <p class="text-jp-muted pe-lg-4 mb-3" style="font-size: 0.92rem; line-height: 1.6;">
                        Especialistas en ingeniería de software web, gestión avanzada de infraestructura en la nube, dominios, soluciones corporativas de Google Workspace &amp; Gemini AI, y diagnósticos técnicos remotos para empresas y organizaciones.
                    </p>
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25);">
                        <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #10b981;"></span>
                        <span class="text-success small fw-semibold">Operaciones y Soporte Remoto Activo</span>
                    </div>
                </div>

                <!-- Col 2: Ecosystem -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title">Ecosistema</h5>
                    <ul class="footer-links">
                        <li>
                            <a asp-controller="Home" asp-action="Nosotros">
                                <i class="bi bi-info-circle me-1 small text-info"></i> Quiénes Somos / Nosotros
                            </a>
                        </li>
                        <li>
                            <a href="https://erp.globalesjp.net/" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-box-arrow-up-right me-1 small text-warning"></i> GLOBALES JP | ERP
                            </a>
                        </li>
                        <li>
                            <a href="https://cursos.globalesjp.net/" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-box-arrow-up-right me-1 small text-cyan"></i> Cursos Globales JP
                            </a>
                        </li>
                        <li><a href="/#nosotros"><i class="bi bi-shield-check me-1 small text-emerald"></i> Seguridad &amp; Cloud (MSP/DRP)</a></li>
                        <li><a href="/#contacto"><i class="bi bi-send-fill me-1 small text-primary"></i> Solicitar Asesoría</a></li>
                    </ul>
                </div>

                <!-- Col 3: Official Channels -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-title">Canales Oficiales</h5>
                    <p class="text-jp-muted small mb-3">Atención inmediata a través de nuestras plataformas digitales:</p>
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <a href="https://wa.me/584142241795" target="_blank" rel="noopener noreferrer" class="footer-social-btn" title="WhatsApp Business" aria-label="WhatsApp">
                            <i class="bi bi-whatsapp"></i>
                        </a>
                        <a href="https://www.instagram.com/globalesjp" target="_blank" rel="noopener noreferrer" class="footer-social-btn" title="Instagram @@globalesjp" aria-label="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="https://www.tiktok.com/@@globalesjp" target="_blank" rel="noopener noreferrer" class="footer-social-btn" title="TikTok @@globalesjp" aria-label="TikTok">
                            <i class="bi bi-tiktok"></i>
                        </a>
                        <a href="mailto:contacto@globalesjp.net" class="footer-social-btn" title="Correo corporativo" aria-label="Correo">
                            <i class="bi bi-envelope-fill"></i>
                        </a>
                    </div>
                    <div class="small text-jp-muted">
                        <div class="mb-1"><i class="bi bi-envelope text-info me-2"></i>contacto@globalesjp.net</div>
                        <div><i class="bi bi-phone text-success me-2"></i>+58 (414) 224.17.95</div>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-top border-secondary border-opacity-10 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-jp-muted text-center text-md-start">
                    &copy; 2026 <strong>Inversiones Globales JP 1968, C.A.</strong> Todos los derechos reservados.
                    <span class="d-block d-sm-inline mt-1 mt-sm-0 ms-sm-2 text-secondary">Soluciones TI &amp; Software Remoto.</span>
                </div>
                <div class="d-flex align-items-center gap-3 small text-jp-muted">
                    <a asp-controller="Home" asp-action="Nosotros" class="text-decoration-none text-jp-muted">Quiénes Somos</a>
                    <span>&bull;</span>
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-jp-muted">Privacidad</a>
                    <span>&bull;</span>
                    <a href="/#contacto" class="text-decoration-none text-jp-muted">Términos de Servicio</a>
                    <span>&bull;</span>
                    <a href="https://cursos.globalesjp.net/" target="_blank" class="text-decoration-none text-jp-muted">Campus Virtual</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap & jQuery Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Tally Embed Script -->
    <script async src="https://tally.so/widgets/embed.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
